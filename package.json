{
  "name": "steel-sales-risk-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Steel Sales Risk Intelligence & Early Warning Dashboard for coated-steel (CRC/GI/GL/PPGI) export sales",
  "scripts": {
    "collect:market": "node scripts/collect-market.mjs",
    "collect:news": "node scripts/collect-news.mjs",
    "collect:fx": "node scripts/collect-fx.mjs",
    "collect:freight": "node scripts/collect-freight.mjs",
    "collect": "npm run collect:market && npm run collect:news && npm run collect:fx && npm run collect:freight",
    "analyze": "node scripts/analyze.mjs",
    "refresh": "node scripts/refresh.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "digest": "node scripts/send-digest.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "lightweight-charts": "^5.2.1",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
